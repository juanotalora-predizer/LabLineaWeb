# Copiar a .env y completar. .env nunca se sube al repositorio.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lablinea_dev
DB_NAME_TEST=lablinea_test

# Dueño de los esquemas: solo para migraciones (Alembic).
DB_OWNER_USER=lablinea_owner
DB_OWNER_PASSWORD=

# Rol de la aplicación: sin privilegios de dueño, para que RLS se aplique.
DB_APP_USER=lablinea_app
DB_APP_PASSWORD=
