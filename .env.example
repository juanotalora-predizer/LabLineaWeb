# Copiar a .env y completar. .env nunca se sube al repositorio.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lablinea_dev
DB_NAME_TEST=lablinea_test

# Dueño de los esquemas: solo para migraciones (Alembic).
DB_OWNER_USER=lablinea_owner
DB_OWNER_PASSWORD=

# Rol de la aplicación: sin privilegios de dueño, para que RLS se aplique.
DB_APP_USER=lablinea_app
DB_APP_PASSWORD=

# Rol del Admin Hub: solo el esquema plataforma.
DB_PLATAFORMA_USER=lablinea_plataforma
DB_PLATAFORMA_PASSWORD=

# Clave maestra para cifrar secretos TOTP y derivar claves HMAC (32 bytes en base64):
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
CLAVE_CIFRADO=

# Correo: en local, servidor de captura (python -m aiosmtpd -n -l 127.0.0.1:1025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Solo desarrollo: credenciales de los usuarios sintéticos (scripts/sembrar_desarrollo.py).
DEV_CLAVE_USUARIOS=
DEV_TOTP_SECRETO=
